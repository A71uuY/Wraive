# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#} 

# Gson may deserialize ModelConfig.capabilities as raw strings after R8 removes
# the field's generic element type. Keep every persisted capability enum value
# available for the repository's compatibility conversion.
-keep enum moye.wear.wraive.model.ModelCapability { *; }

# Memory extraction uses valueOf and Gson; preserve every category in release builds.
-keep enum moye.wear.wraive.model.MemoryCategory { *; }

# Search configurations use Gson reflection to persist every selectable provider.
-keep enum moye.wear.wraive.model.SearchProviderType { *; }

# Preserve SDK calls so the device's Wear implementation wins class loading.
-keep class com.google.wear.input.WearHapticFeedbackConstants {
    public static int getScrollItemFocus();
    public static int getScrollTick();
    public static int getScrollLimit();
}

# Gson persists these fields by their Kotlin names in SQLite, preferences and backups.
# Keep the JSON schema identical across debug, release and future updates.
-keepattributes Signature,InnerClasses,EnclosingMethod
-keep class moye.wear.wraive.model.** { <fields>; <init>(...); }
-keep enum moye.wear.wraive.model.** { *; }
-keep class moye.wear.wraive.data.RepositorySnapshot { <fields>; <init>(...); }
-keep class moye.wear.wraive.data.CloudSecrets { <fields>; <init>(...); }
-keep class moye.wear.wraive.data.BackupService$BackupBundle { <fields>; <init>(...); }
